# Copy this file to `.env` and set real values.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gauis_db
DB_USER=gauis_user
DB_PASSWORD=changeme

# Authentication / JWT
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=45m

# OTP settings
OTP_EXPIRY_MINUTES=5
